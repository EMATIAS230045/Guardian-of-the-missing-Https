# ==========================================
# CONFIGURACIÓN DE BASES DE DATOS
# ==========================================

# MONGODB (Ejemplo con MongoDB Atlas M0)
# Sustituye <user>, <password> y <cluster-url> con los datos reales de tu clúster
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=guardian_geo

# MYSQL (Ejemplo con TiDB Cloud Serverless o Aiven)
# Sustituye con los datos proporcionados por tu proveedor cloud
MYSQL_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=user_123.root
MYSQL_PASSWORD=tu_password_seguro
MYSQL_DB=guardian

# OTRAS VARIABLES (Ej. JWT, Entorno)
ENVIRONMENT=production
SECRET_KEY=tu_super_secreto_para_jwt
